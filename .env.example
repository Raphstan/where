# Variables d'environnement de WHERE.
# Copier ce fichier en .env.local et remplir les valeurs. Une ligne de commentaire par variable.
# Aucune variable n'est lue dans le code sans figurer ici (voir src/lib/env.ts).

# URL de l'API Supabase. En local : http://127.0.0.1:54321 (affichée par `npm run db:start`).
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique Supabase (anon key, ou publishable key sb_publishable_…). Exposée au navigateur,
# protégée par RLS. Jamais la clé service_role ici.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique du site, utilisée pour construire le lien magique. En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé API Anthropic, côté serveur uniquement (compréhension des questions, classification des emails).
# Jamais de préfixe NEXT_PUBLIC_. Obligatoire pour /api/ask hors mode factice.
ANTHROPIC_API_KEY=

# Clé Google Places API (New), côté serveur uniquement. Sert à proposer au plus une « Découverte »
# hors du cercle. Facultative : sans clé, les résultats viennent uniquement de la mémoire.
GOOGLE_PLACES_API_KEY=

# Clé Supabase service_role (ou secret key sb_secret_…), côté serveur uniquement, jamais NEXT_PUBLIC_.
# Utilisée seulement par la page invité /r/[token], le cron des retours et le webhook Resend entrant
# (src/lib/supabase/admin.ts).
# En local : affichée par db:start.
SUPABASE_SERVICE_ROLE_KEY=

# Secret de la tâche planifiée Vercel (vercel.json) : Vercel l'envoie en « Authorization: Bearer … ».
# 16 caractères au moins, ex. `openssl rand -hex 32`. Sans valeur, /api/cron/visit-followups refuse tout.
CRON_SECRET=

# Domaine de réception Resend (inbound) : chaque compte reçoit inbox+{jeton}@<domaine>. Ex. where.app,
# ou le sous-domaine <id>.resend.app fourni par Resend. Sans valeur, l'écran d'import n'affiche pas d'adresse.
WHERE_INBOUND_DOMAIN=

# Clé API Resend, côté serveur uniquement : lit le contenu des emails reçus (GET /emails/receiving/{id}).
RESEND_API_KEY=

# Secret de signature du webhook Resend « email.received » (whsec_…). Sans valeur, /api/inbound/resend refuse tout.
RESEND_WEBHOOK_SECRET=

# Mode factice pour développer sans clé : 1 pour une compréhension simulée (/api/ask) et une
# classification des emails par mots-clés (webhook Resend). Ignoré en production.
WHERE_ASK_MOCK=
